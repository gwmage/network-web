{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOME_OTHER_KEY"
  ],
  "healthCheck": {
    "path": "/api/health",
    "timeout": 180
  },
  "experimental": {
    "urlRewrites": []
  },
  "target": "serverless"
}
