{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/api/health",
      "dest": "/api/health"
    }
  ],
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOME_OTHER_KEY"
  ],
  "healthCheck": {
    "path": "/api/health"
  },
  "functions": {
    "api/**/*.js": {
      "timeout": 300
    }
  }
}