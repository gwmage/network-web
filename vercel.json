{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOME_OTHER_KEY"
  ],
  "healthCheck": {
    "path": "/api/health",
    "timeout": 120000
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/**/*.{ts,tsx,js,jsx}": {
      "timeout": 120
    }
  }
}