{
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOME_OTHER_KEY"
  ],
  "healthCheck": {
    "path": "/api/health",
    "timeout": 600
  },
  "routes": [
    {
      "src": "/api/(.+)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/**/*.{ts,tsx,js,jsx}": {
      "timeout": 300
    }
  }
}