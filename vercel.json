{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SOME_OTHER_KEY"
  ],
  "healthCheck": {
    "path": "/api/health"
  },
  "routes": [
    {
      "src": "/api/(.+)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/**/*.{ts,tsx,js,jsx}": {
      "timeout": 300
    },
    "api/health.js": {
      "timeout": 30000
    }
  },
  "preview": {
    "functions": {
      "api/health.js": {
        "includeFiles": ".*"
      }
    }
  }
}