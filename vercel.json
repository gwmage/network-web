{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/"
    },
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
        {
      "src": "/(.*)",
      "dest": "/$1"
    }

  ]
}