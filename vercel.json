{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/api/health",
      "dest": "pages/api/health.js"
    },
    {
      "src": "/api/hello",
      "dest": "pages/api/hello.js"
    }
  ],
  "timeout": 15
}